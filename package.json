{
  "name": "dsh-provider-quota-rings",
  "version": "0.1.10",
  "private": true,
  "description": "DeepSeek Harness 侧栏底部的订阅额度圆环。独立实现，默认不读取账号。",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22.19"
  },
  "icon": "./icon.svg",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json",
    "./locale/zh.json": "./locale/zh.json",
    "./locale/en.json": "./locale/en.json"
  },
  "files": [
    "index.js",
    "client.js",
    "src",
    "native",
    "locale",
    "bin",
    "cordis.patch.yml",
    "icon.svg",
    "README.md",
    "docs",
    "tests"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-api-remotes"
      ]
    }
  },
  "scripts": {
    "test": "node --test tests/*.test.mjs"
  }
}
